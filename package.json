{
  "name": "ai-factory",
  "version": "1.0.0",
  "private": true,
  "description": "AI Factory - A complete AI company with employees, departments, and operations",
  "scripts": {
    "dev": "pnpm --filter @ai-factory/dashboard dev",
    "build": "pnpm -r run build",
    "build:prod": "pnpm run build && pnpm run build:orchestrator",
    "build:orchestrator": "cd packages/orchestrator && cargo build --release",
    "test": "pnpm -r run test",
    "test:unit": "pnpm -r run test:unit",
    "test:integration": "pnpm -r run test:integration",
    "test:e2e": "pnpm -r run test:e2e",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "db:generate": "pnpm --filter @ai-factory/core db:generate",
    "db:push": "pnpm --filter @ai-factory/core db:push",
    "db:seed": "pnpm --filter @ai-factory/core db:seed",
    "db:studio": "pnpm --filter @ai-factory/core db:studio",
    "import:agents": "pnpm --filter import-agents run import",
    "orchestrator:dev": "cd packages/orchestrator && cargo run",
    "docs:generate": "pnpm --filter docs run generate",
    "clean": "pnpm -r run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
