generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
// CORE: USERS & ORGANIZATIONS
// ═══════════════════════════════════════════════════════════════

model User {
  id            String    @id @default(cuid())
  clerkId       String    @unique
  email         String    @unique
  name          String?
  imageUrl      String?
  role          UserRole  @default(EMPLOYEE)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  orgMemberships OrgMember[]
  ownedOrgs     Organization[] @relation("OrganizationOwner")
  createdTasks  Task[]       @relation("TaskCreator")
  messages      Message[]
  approvals     Approval[]   @relation("ApprovalRequester")
  decidedApprovals Approval[] @relation("ApprovalDecider")
  taskComments  TaskComment[]
  approvalAssignments ApprovalApprover[]
  conversationParticipations ConversationParticipant[]
  messageReactions MessageReaction[]
  performanceReviews PerformanceReview[]
  preferences   UserPreferences?

  @@index([clerkId])
  @@index([email])
  @@map("users")
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  EMPLOYEE
  CONTRACTOR
  VIEWER
}

model UserPreferences {
  id                 String   @id @default(cuid())
  userId             String   @unique
  theme              String   @default("dark")
  notificationsEmail Boolean  @default(true)
  notificationsPush  Boolean  @default(true)
  notificationsSlack Boolean  @default(false)
  notificationsWhatsApp Boolean @default(true)
  language           String   @default("en")
  timezone           String   @default("UTC")
  workingHoursStart  String   @default("09:00")
  workingHoursEnd    String   @default("17:00")
  workingDays        Int[]    @default([1,2,3,4,5])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  website     String?
  industry    String?
  size        OrgSize  @default(SMALL)
  isActive    Boolean  @default(true)
  settings    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  ownerId     String
  owner       User     @relation("OrganizationOwner", fields: [ownerId], references: [id])
  members     OrgMember[]
  departments Department[]
  employees   Employee[]
  projects    Project[]
  workflows   Workflow[]
  skills      Skill[]
  budget      Budget?
  tasks       Task[]
  approvals   Approval[]
  conversations Conversation[]
  goals       Goal[]
  transactions Transaction[]
  activities  Activity[]
  integrations Integration[]
  webhooks    Webhook[]
  whatsAppSessions WhatsAppSession[]
  pixelOfficeLayout PixelOfficeLayout?
  jarvisSettings JarvisSettings?

  @@index([slug])
  @@map("organizations")
}

enum OrgSize {
  SOLO
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

model OrgMember {
  id        String      @id @default(cuid())
  userId    String
  orgId     String
  role      OrgRole     @default(MEMBER)
  departmentId String?
  joinedAt  DateTime    @default(now())
  leftAt    DateTime?

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([departmentId])
  @@map("org_members")
}

enum OrgRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

// ═══════════════════════════════════════════════════════════════
// DEPARTMENTS & EMPLOYEES (AGENTS)
// ═══════════════════════════════════════════════════════════════

model Department {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  slug        String
  description String?
  color       String   @default("#6366f1")
  icon        String?
  parentId    String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  budget      Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent      Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Department[] @relation("DepartmentHierarchy")
  employees   Employee[]
  projects    Project[]
  goals       Goal[]
  members     OrgMember[]
  tasks       Task[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@index([parentId])
  @@map("departments")
}

model Employee {
  id              String           @id @default(cuid())
  orgId           String
  departmentId    String?
  personaId       String           @unique
  name            String
  title           String
  slug            String
  email           String?          @unique
  avatarUrl       String?
  bio             String?
  systemPrompt    String           @db.Text
  personality     String           @db.Text
  model           String           @default("claude-sonnet-4-20250514")
  temperature     Float            @default(0.7)
  maxTokens       Int              @default(4096)
  tools           Json             @default("[]")
  skillTags       String[]         @default([])
  status          EmployeeStatus   @default(ACTIVE)
  employmentType  EmploymentType   @default(FULL_TIME)
  hireDate        DateTime         @default(now())
  terminationDate DateTime?
  salary          Decimal?         @db.Decimal(12, 2)
  hourlyRate      Decimal?         @db.Decimal(10, 2)
  performanceScore Float           @default(0)
  totalTasksCompleted Int          @default(0)
  totalMessagesSent  Int           @default(0)
  totalTokensUsed    BigInt        @default(0)
  totalCost           Decimal      @db.Decimal(12, 4) @default(0)
  lastActiveAt      DateTime?
  metadata        Json             @default("{}")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  org             Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department      Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  persona         Persona          @relation(fields: [personaId], references: [id], onDelete: Restrict)
  tasks           Task[]           @relation("TaskAssignee")
  messages        Message[]
  conversations   ConversationParticipant[]
  skills          EmployeeSkill[]
  performanceReviews PerformanceReview[]
  schedules       WorkSchedule[]
  timeEntries     TimeEntry[]
  projectMemberships ProjectMember[]
  messageReactions MessageReaction[]
  ownedGoals      Goal[]
  transactions    Transaction[]
  pixelAgentState PixelAgentState?

  @@unique([orgId, slug])
  @@index([orgId])
  @@index([departmentId])
  @@index([personaId])
  @@index([status])
  @@map("employees")
}

enum EmployeeStatus {
  ACTIVE
  ONBOARDING
  ON_LEAVE
  OFFBOARDING
  TERMINATED
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
  INTERN
  AI_AGENT
}

model WorkSchedule {
  id          String   @id @default(cuid())
  employeeId  String
  dayOfWeek   Int      // 0-6
  startTime   String   // HH:mm
  endTime     String   // HH:mm
  timezone    String   @default("UTC")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, dayOfWeek])
  @@map("work_schedules")
}

model TimeEntry {
  id          String   @id @default(cuid())
  employeeId  String
  taskId      String?
  projectId   String?
  description String?
  startTime   DateTime
  endTime     DateTime?
  duration    Int?     // minutes
  billable    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([taskId])
  @@index([projectId])
  @@index([startTime])
  @@map("time_entries")
}

// ═══════════════════════════════════════════════════════════════
// PERSONAS (from agency-agents)
// ═══════════════════════════════════════════════════════════════

model Persona {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  category       PersonaCategory
  subcategory    String?
  description    String           @db.Text
  personality    String?          @db.Text
  systemPrompt   String           @db.Text
  model          String           @default("claude-sonnet-4-20250514")
  temperature    Float            @default(0.7)
  maxTokens      Int              @default(4096)
  tools          Json             @default("[]")
  suggestedSkills String[]        @default([])
  avatarUrl      String?
  isPublic       Boolean          @default(true)
  isActive       Boolean          @default(true)
  source         String           @default("agency-agents") // agency-agents, custom, marketplace
  sourceUrl      String?
  deployCount    Int              @default(0)
  rating         Float            @default(0)
  ratingCount    Int              @default(0)
  tags           String[]         @default([])
  metadata       Json             @default("{}")
  createdBy      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  employees      Employee[]
  marketplaceListing MarketplaceListing?

  @@index([category])
  @@index([isActive])
  @@index([rating])
  @@index([isPublic])
  @@map("personas")
}

enum PersonaCategory {
  ENGINEERING
  DESIGN
  MARKETING
  SALES
  PRODUCT
  STRATEGY
  SUPPORT
  TESTING
  DATA
  INFRASTRUCTURE
  GAME_DEVELOPMENT
  ACADEMIC
  SPECIALIZED
  OPERATIONS
  FINANCE
  HR
  LEGAL
  SECURITY
  RESEARCH
}

// ═══════════════════════════════════════════════════════════════
// SKILLS & MARKETPLACE (from awesome-skills, openclaw-usecases, clawhub)
// ═══════════════════════════════════════════════════════════════

model Skill {
  id              String       @id @default(cuid())
  orgId           String?
  name            String
  slug            String
  description     String       @db.Text
  category        SkillCategory
  subcategory     String?
  version         String       @default("1.0.0")
  manifest        Json         // Skill manifest (inputs, outputs, config)
  code            String?      @db.Text // Source code for custom skills
  entryPoint      String?      // e.g., "main.py", "index.ts"
  runtime         SkillRuntime @default(TYPESCRIPT)
  dependencies    Json         @default("[]") // npm/pip/cargo deps
  environment     Json         @default("{}") // env vars, secrets
  isPublic        Boolean      @default(false)
  isActive        Boolean      @default(true)
  isOfficial      Boolean      @default(false)
  installs        Int          @default(0)
  rating          Float        @default(0)
  ratingCount     Int          @default(0)
  price           Decimal      @db.Decimal(10, 2) @default(0)
  revenue         Decimal      @db.Decimal(12, 2) @default(0)
  authorId        String?
  source          String       @default("custom") // awesome-skills, openclaw-usecases, claude-ads, custom, marketplace
  sourceUrl       String?
  tags            String[]     @default([])
  documentation   String?      @db.Text
  readme          String?      @db.Text
  license         String       @default("MIT")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  org             Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employeeSkills  EmployeeSkill[]
  marketplaceListing MarketplaceListing?

  @@unique([orgId, slug])
  @@index([category])
  @@index([isPublic])
  @@index([isOfficial])
  @@index([installs])
  @@map("skills")
}

enum SkillCategory {
  DEVELOPMENT
  DESIGN
  MARKETING
  SALES
  DATA_ANALYSIS
  AUTOMATION
  COMMUNICATION
  RESEARCH
  SECURITY
  INFRASTRUCTURE
  AI_ML
  WRITING
  TRANSLATION
  FINANCE
  HR
  LEGAL
  CUSTOMER_SUPPORT
  PROJECT_MANAGEMENT
  CLAUDE_ADS
  OPENCLAW_USECASE
}

enum SkillRuntime {
  TYPESCRIPT
  PYTHON
  RUST
  GO
  DOCKER
  WASM
  BINARY
}

model EmployeeSkill {
  id          String   @id @default(cuid())
  employeeId  String
  skillId     String
  proficiency Int      @default(50) // 0-100
  assignedAt  DateTime @default(now())
  assignedBy  String?
  isActive    Boolean  @default(true)

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([employeeId, skillId])
  @@index([employeeId])
  @@index([skillId])
  @@map("employee_skills")
}

model MarketplaceListing {
  id          String   @id @default(cuid())
  personaId   String?  @unique
  skillId     String?  @unique
  featured    Boolean  @default(false)
  price       Decimal  @db.Decimal(10, 2) @default(0)
  revenueShare Int     @default(80) // creator gets 80%
  installs    Int      @default(0)
  revenue     Decimal  @db.Decimal(12, 2) @default(0)
  description String?  @db.Text
  screenshots String[] @default([])
  videoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  persona     Persona? @relation(fields: [personaId], references: [id], onDelete: Cascade)
  skill       Skill?   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([featured])
  @@index([installs])
  @@map("marketplace_listings")
}

// ═══════════════════════════════════════════════════════════════
// PROJECTS, TASKS & WORKFLOWS (LobsterAI + Mission Control)
// ═══════════════════════════════════════════════════════════════

model Project {
  id          String        @id @default(cuid())
  orgId       String
  departmentId String?
  name        String
  slug        String
  description String?       @db.Text
  status      ProjectStatus @default(PLANNING)
  priority    Priority      @default(MEDIUM)
  startDate   DateTime?
  endDate     DateTime?
  budget      Decimal?      @db.Decimal(12, 2)
  spent       Decimal       @db.Decimal(12, 2) @default(0)
  progress    Int           @default(0) // 0-100
  metadata    Json          @default("{}")
  createdBy   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  org         Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department  Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  tasks       Task[]
  workflows   Workflow[]
  goals       Goal[]
  members     ProjectMember[]
  timeEntries TimeEntry[]
  attachments Attachment[]
  transactions Transaction[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@index([departmentId])
  @@index([status])
  @@map("projects")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  URGENT
}

model ProjectMember {
  id        String        @id @default(cuid())
  projectId String
  employeeId String
  role      ProjectRole   @default(MEMBER)
  joinedAt  DateTime      @default(now())
  leftAt    DateTime?

  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee  Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([projectId, employeeId])
  @@index([projectId])
  @@index([employeeId])
  @@map("project_members")
}

enum ProjectRole {
  OWNER
  LEAD
  MEMBER
  VIEWER
}

model Task {
  id              String       @id @default(cuid())
  orgId           String
  projectId       String?
  departmentId    String?
  creatorId       String
  assigneeId      String?
  title           String
  description     String?      @db.Text
  status          TaskStatus   @default(TODO)
  priority        Priority     @default(MEDIUM)
  type            TaskType     @default(TASK)
  storyPoints     Int?
  estimatedHours  Decimal?     @db.Decimal(6, 2)
  actualHours     Decimal      @db.Decimal(6, 2) @default(0)
  dueDate         DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  dependsOn       String[]     @default([])
  tags            String[]     @default([])
  metadata        Json         @default("{}")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project         Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  department      Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  creator         User         @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  assignee        Employee?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  subtasks        Task[]       @relation("TaskSubtasks")
  parentTask      Task?        @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: SetNull)
  parentId        String?
  comments        TaskComment[]
  attachments     Attachment[]
  timeEntries     TimeEntry[]
  workflowRuns    WorkflowRun[]
  approvals       Approval[]

  @@index([orgId])
  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

enum TaskStatus {
  TODO
  BACKLOG
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  NEEDS_APPROVAL
  APPROVED
  DONE
  CANCELLED
}

enum TaskType {
  TASK
  BUG
  FEATURE
  EPIC
  STORY
  SPIKE
  CHORE
  REVIEW
  DEPLOYMENT
  MEETING
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  content   String   @db.Text
  isSystem  Boolean  @default(false)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@index([authorId])
  @@map("task_comments")
}

model Attachment {
  id        String   @id @default(cuid())
  taskId    String?
  projectId String?
  name      String
  url       String
  mimeType  String
  size      BigInt
  uploadedBy String
  createdAt DateTime @default(now())

  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([projectId])
  @@map("attachments")
}

// ═══════════════════════════════════════════════════════════════
// WORKFLOWS (LobsterAI)
// ═══════════════════════════════════════════════════════════════

model Workflow {
  id          String           @id @default(cuid())
  orgId       String
  projectId   String?
  name        String
  slug        String
  description String?          @db.Text
  version     String           @default("1.0.0")
  definition  Json             // Lobster pipeline definition
  status      WorkflowStatus   @default(DRAFT)
  isTemplate  Boolean          @default(false)
  trigger     WorkflowTrigger  @default(MANUAL)
  schedule    String?          // Cron expression
  runCount    Int              @default(0)
  successRate Float            @default(0)
  avgDuration Int              @default(0) // seconds
  createdBy   String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  runs        WorkflowRun[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@index([projectId])
  @@index([status])
  @@map("workflows")
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
  DEPRECATED
  ARCHIVED
}

enum WorkflowTrigger {
  MANUAL
  SCHEDULED
  WEBHOOK
  EVENT
  TASK_CREATED
  TASK_COMPLETED
  APPROVAL_REQUESTED
}

model WorkflowRun {
  id            String              @id @default(cuid())
  workflowId    String
  taskId        String?
  status        WorkflowRunStatus   @default(PENDING)
  currentStep   Int                 @default(0)
  input         Json?
  output        Json?
  steps         Json                @default("[]") // Step execution history
  startedAt     DateTime            @default(now())
  completedAt   DateTime?
  error         String?
  triggeredBy   String?
  metadata      Json                @default("{}")

  workflow      Workflow            @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  task          Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  approvals     Approval[]

  @@index([workflowId])
  @@index([taskId])
  @@index([status])
  @@map("workflow_runs")
}

enum WorkflowRunStatus {
  PENDING
  RUNNING
  NEEDS_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
  FAILED
  CANCELLED
  PAUSED
}

// ═══════════════════════════════════════════════════════════════
// APPROVALS (Mission Control)
// ═══════════════════════════════════════════════════════════════

model Approval {
  id            String           @id @default(cuid())
  orgId         String
  workflowRunId String?
  taskId        String?
  title         String
  description   String?          @db.Text
  type          ApprovalType
  status        ApprovalStatus   @default(PENDING)
  requestedBy   String
  decidedBy     String?
  decidedAt     DateTime?
  decision      String?
  reason        String?
  expiresAt     DateTime?
  metadata      Json             @default("{}")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  org           Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workflowRun   WorkflowRun?     @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)
  task          Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  requester     User             @relation("ApprovalRequester", fields: [requestedBy], references: [id], onDelete: Restrict)
  decider       User?            @relation("ApprovalDecider", fields: [decidedBy], references: [id], onDelete: SetNull)
  approvers     ApprovalApprover[]

  @@index([orgId])
  @@index([workflowRunId])
  @@index([taskId])
  @@index([status])
  @@index([requestedBy])
  @@map("approvals")
}

enum ApprovalType {
  TASK_ASSIGNMENT
  BUDGET_APPROVAL
  DEPLOYMENT
  RELEASE
  POLICY_EXCEPTION
  HIRING
  TERMINATION
  PURCHASE
  DATA_ACCESS
  CUSTOM
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
  ESCALATED
}

model ApprovalApprover {
  id          String   @id @default(cuid())
  approvalId  String
  userId      String
  order       Int      @default(0)
  isRequired  Boolean  @default(true)
  status      ApprovalStatus @default(PENDING)
  decidedAt   DateTime?
  comment     String?

  approval    Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([approvalId, userId])
  @@index([approvalId])
  @@index([userId])
  @@map("approval_approvers")
}

// ═══════════════════════════════════════════════════════════════
// COMMUNICATION (acpx, WhatsApp, Channels)
// ═══════════════════════════════════════════════════════════════

model Conversation {
  id              String               @id @default(cuid())
  orgId           String
  type            ConversationType     @default(DIRECT)
  title           String?
  description     String?
  isPrivate       Boolean              @default(false)
  isArchived      Boolean              @default(false)
  metadata        Json                 @default("{}")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  lastMessageAt   DateTime?

  org             Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  participants    ConversationParticipant[]
  messages        Message[]

  @@index([orgId])
  @@index([type])
  @@map("conversations")
}

enum ConversationType {
  DIRECT
  GROUP
  CHANNEL
  ANNOUNCEMENT
  WHATSAPP_GROUP
  SUPPORT
}

model ConversationParticipant {
  id              String   @id @default(cuid())
  conversationId  String
  employeeId      String?
  userId          String?
  role            ParticipantRole @default(MEMBER)
  joinedAt        DateTime @default(now())
  leftAt          DateTime?
  lastReadAt      DateTime?
  isMuted         Boolean  @default(false)
  notifications   Boolean  @default(true)

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  employee        Employee?    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  user            User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, employeeId])
  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([employeeId])
  @@index([userId])
  @@map("conversation_participants")
}

enum ParticipantRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
  BOT
}

model Message {
  id              String        @id @default(cuid())
  conversationId  String
  senderEmployeeId String?
  senderUserId    String?
  content         String        @db.Text
  type            MessageType   @default(TEXT)
  metadata        Json          @default("{}")
  replyToId       String?
  editedAt        DateTime?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())

  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderEmployee  Employee?     @relation(fields: [senderEmployeeId], references: [id], onDelete: SetNull)
  senderUser      User?         @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  replyTo         Message?      @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         Message[]     @relation("MessageReplies")
  reactions       MessageReaction[]
  attachments     MessageAttachment[]

  @@index([conversationId])
  @@index([senderEmployeeId])
  @@index([senderUserId])
  @@index([createdAt])
  @@map("messages")
}

enum MessageType {
  TEXT
  MARKDOWN
  CODE
  IMAGE
  FILE
  AUDIO
  VIDEO
  LOCATION
  CONTACT
  POLL
  SYSTEM
  TOOL_CALL
  TOOL_RESULT
  APPROVAL_REQUEST
  APPROVAL_RESPONSE
  TASK_UPDATE
  WORKFLOW_EVENT
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  employeeId String?
  userId    String?
  emoji     String
  createdAt DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  employee  Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, employeeId, emoji])
  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  name      String
  url       String
  mimeType  String
  size      BigInt
  createdAt DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}

// ═══════════════════════════════════════════════════════════════
// GOALS & OKRs
// ═══════════════════════════════════════════════════════════════

model Goal {
  id          String       @id @default(cuid())
  orgId       String
  departmentId String?
  projectId   String?
  title       String
  description String?      @db.Text
  type        GoalType     @default(OKR)
  status      GoalStatus   @default(DRAFT)
  progress    Int          @default(0)
  targetValue Decimal?     @db.Decimal(12, 2)
  currentValue Decimal     @db.Decimal(12, 2) @default(0)
  unit        String?
  startDate   DateTime
  endDate     DateTime
  ownerId     String?
  parentId    String?
  metadata    Json         @default("{}")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department  Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  owner       Employee?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  parent      Goal?        @relation("GoalHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Goal[]       @relation("GoalHierarchy")
  keyResults  KeyResult[]

  @@index([orgId])
  @@index([departmentId])
  @@index([projectId])
  @@index([status])
  @@map("goals")
}

enum GoalType {
  OKR
  KPI
  MILESTONE
  INITIATIVE
  TARGET
}

enum GoalStatus {
  DRAFT
  ACTIVE
  ON_TRACK
  AT_RISK
  OFF_TRACK
  COMPLETED
  FAILED
  CANCELLED
}

model KeyResult {
  id          String   @id @default(cuid())
  goalId      String
  title       String
  description String?  @db.Text
  targetValue Decimal  @db.Decimal(12, 2)
  currentValue Decimal @db.Decimal(12, 2) @default(0)
  unit        String?
  weight      Int      @default(1) // For weighted progress
  status      GoalStatus @default(DRAFT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("key_results")
}

// ═══════════════════════════════════════════════════════════════
// BUDGET & FINANCE
// ═══════════════════════════════════════════════════════════════

model Budget {
  id          String   @id @default(cuid())
  orgId       String   @unique
  totalAllocated Decimal @db.Decimal(14, 2) @default(0)
  totalSpent   Decimal  @db.Decimal(14, 2) @default(0)
  currency     String   @default("USD")
  period       BudgetPeriod @default(MONTHLY)
  periodStart  DateTime
  periodEnd    DateTime
  alerts       Json     @default("{}") // thresholds, notifications
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lineItems    BudgetLineItem[]
  transactions Transaction[]

  @@map("budgets")
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

model BudgetLineItem {
  id          String   @id @default(cuid())
  budgetId    String
  category    String
  name        String
  allocated   Decimal  @db.Decimal(12, 2)
  spent       Decimal  @db.Decimal(12, 2) @default(0)
  description String?
  isRecurring Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  budget      Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
  @@map("budget_line_items")
}

model Transaction {
  id            String           @id @default(cuid())
  orgId         String
  budgetId      String?
  employeeId    String?
  projectId     String?
  type          TransactionType
  amount        Decimal          @db.Decimal(12, 4)
  currency      String           @default("USD")
  description   String
  category      String
  provider      String?          // groq, gemini, ollama, openai, etc.
  model         String?
  tokensUsed    BigInt?
  status        TransactionStatus @default(COMPLETED)
  metadata      Json             @default("{}")
  createdAt     DateTime         @default(now())

  org           Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  budget        Budget?          @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  employee      Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  project       Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([budgetId])
  @@index([employeeId])
  @@index([projectId])
  @@index([type])
  @@index([createdAt])
  @@map("transactions")
}

enum TransactionType {
  LLM_USAGE
  SKILL_PURCHASE
  MARKETPLACE_FEE
  SUBSCRIPTION
  SALARY
  INFRASTRUCTURE
  TRAINING
  MISCELLANEOUS
  REFUND
  CREDIT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

// ═══════════════════════════════════════════════════════════════
// PERFORMANCE & REVIEWS
// ═══════════════════════════════════════════════════════════════

model PerformanceReview {
  id            String   @id @default(cuid())
  employeeId    String
  reviewerId    String
  periodStart   DateTime
  periodEnd     DateTime
  status        ReviewStatus @default(DRAFT)
  overallScore  Float    @default(0)
  strengths     String?  @db.Text
  improvements  String?  @db.Text
  goals         String?  @db.Text
  feedback      String?  @db.Text
  metadata      Json     @default("{}")
  submittedAt   DateTime?
  acknowledgedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer      User     @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  criteria      ReviewCriterion[]

  @@index([employeeId])
  @@index([reviewerId])
  @@index([status])
  @@map("performance_reviews")
}

enum ReviewStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  ACKNOWLEDGED
  FINALIZED
}

model ReviewCriterion {
  id          String   @id @default(cuid())
  reviewId    String
  name        String
  description String?
  weight      Int      @default(1)
  score       Float    @default(0)
  maxScore    Float    @default(5)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  review      PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_criteria")
}

// ═══════════════════════════════════════════════════════════════
// ACTIVITY & AUDIT (Mission Control)
// ═══════════════════════════════════════════════════════════════

model Activity {
  id          String       @id @default(cuid())
  orgId       String
  actorType   ActorType
  actorId     String       // userId or employeeId
  action      String
  targetType  String?
  targetId    String?
  description String
  metadata    Json         @default("{}")
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime     @default(now())

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([actorType, actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("activities")
}

enum ActorType {
  USER
  EMPLOYEE
  SYSTEM
  WEBHOOK
  ORCHESTRATOR
}

// ═══════════════════════════════════════════════════════════════
// NOTIFICATIONS
// ═══════════════════════════════════════════════════════════════

model Notification {
  id          String              @id @default(cuid())
  orgId       String
  recipientType RecipientType
  recipientId String
  type        NotificationType
  title       String
  message     String
  priority    NotificationPriority @default(NORMAL)
  channels    NotificationChannel[] @default([IN_APP])
  data        Json                @default("{}")
  isRead      Boolean             @default(false)
  readAt      DateTime?
  sentAt      DateTime?
  createdAt   DateTime            @default(now())

  @@index([orgId])
  @@index([recipientType, recipientId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

enum RecipientType {
  USER
  EMPLOYEE
  DEPARTMENT
  ORGANIZATION
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UPDATED
  TASK_COMPLETED
  APPROVAL_REQUESTED
  APPROVAL_DECIDED
  MENTION
  MESSAGE
  WORKFLOW_STARTED
  WORKFLOW_COMPLETED
  WORKFLOW_FAILED
  BUDGET_ALERT
  PERFORMANCE_REVIEW
  GOAL_UPDATE
  SYSTEM_ALERT
  SECURITY_ALERT
  CUSTOM
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
  CRITICAL
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
  SLACK
  WHATSAPP
  SMS
  WEBHOOK
}

// ═══════════════════════════════════════════════════════════════
// INTEGRATIONS & EXTERNAL SERVICES
// ═══════════════════════════════════════════════════════════════

model Integration {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  type        IntegrationType
  provider    String
  config      Json     @default("{}") // encrypted credentials
  isActive    Boolean  @default(true)
  lastSyncAt  DateTime?
  syncStatus  SyncStatus @default(NEVER_SYNCED)
  errorMessage String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, type, provider])
  @@index([orgId])
  @@index([type])
  @@map("integrations")
}

enum IntegrationType {
  LLM_PROVIDER
  MESSAGING
  VERSION_CONTROL
  PROJECT_MANAGEMENT
  CRM
  ANALYTICS
  MONITORING
  STORAGE
  AUTH
  WEBHOOK
  CUSTOM
}

enum SyncStatus {
  NEVER_SYNCED
  SYNCING
  SUCCESS
  FAILED
  PARTIAL
}

model Webhook {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  url         String
  events      String[] @default([])
  secret      String
  isActive    Boolean  @default(true)
  retryCount  Int      @default(3)
  timeout     Int      @default(30) // seconds
  lastTriggered DateTime?
  successCount Int     @default(0)
  failureCount Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deliveries  WebhookDelivery[]

  @@index([orgId])
  @@index([isActive])
  @@map("webhooks")
}

model WebhookDelivery {
  id          String   @id @default(cuid())
  webhookId   String
  event       String
  payload     Json
  responseCode Int?
  responseBody String?
  duration    Int      // ms
  status      DeliveryStatus
  attempt     Int      @default(1)
  error       String?
  createdAt   DateTime @default(now())

  webhook     Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([status])
  @@index([createdAt])
  @@map("webhook_deliveries")
}

enum DeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
  GIVEN_UP
}

// ═══════════════════════════════════════════════════════════════
// WHATSAPP SPECIFIC (connect-with-all-code)
// ═══════════════════════════════════════════════════════════════

model WhatsAppSession {
  id            String   @id @default(cuid())
  orgId         String
  phoneNumber   String   @unique
  name          String
  sessionData   Json     // Baileys session data
  status        WhatsAppStatus @default(CONNECTING)
  qrCode        String?
  lastConnected DateTime?
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  groupChats    WhatsAppGroup[]

  @@index([orgId])
  @@index([status])
  @@map("whatsapp_sessions")
}

enum WhatsAppStatus {
  CONNECTING
  QR_READY
  CONNECTED
  DISCONNECTED
  LOGGED_OUT
  BANNED
}

model WhatsAppGroup {
  id            String   @id @default(cuid())
  sessionId     String
  groupJid      String   @unique
  subject       String
  description   String?
  participantCount Int   @default(0)
  isAnnouncement Boolean  @default(false)
  isAIFactoryGroup Boolean @default(false)
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  session       WhatsAppSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messages      WhatsAppMessage[]

  @@index([sessionId])
  @@index([isAIFactoryGroup])
  @@map("whatsapp_groups")
}

model WhatsAppMessage {
  id            String   @id @default(cuid())
  groupId       String
  messageId     String   // WhatsApp message ID
  senderJid     String
  senderName    String?
  content       String   @db.Text
  type          String
  timestamp     DateTime
  isFromMe      Boolean  @default(false)
  isEmployee    Boolean  @default(false)
  employeeId    String?
  quotedMessageId String?
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())

  group         WhatsAppGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, messageId])
  @@index([groupId])
  @@index([timestamp])
  @@index([employeeId])
  @@map("whatsapp_messages")
}

// ═══════════════════════════════════════════════════════════════
// PIXEL AGENTS (Visual Oversight)
// ═══════════════════════════════════════════════════════════════

model PixelAgentState {
  id            String   @id @default(cuid())
  employeeId    String   @unique
  x             Int      @default(0)
  y             Int      @default(0)
  floor         Int      @default(0)
  state         PixelAgentStateType @default(IDLE)
  currentTask   String?
  animation     String?
  direction     Int      @default(0) // degrees
  deskId        String?
  metadata      Json     @default("{}")
  updatedAt     DateTime @updatedAt

  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("pixel_agent_states")
}

enum PixelAgentStateType {
  IDLE
  WALKING
  WORKING
  TYPING
  THINKING
  MEETING
  BREAK
  OFFLINE
  ERROR
  CELEBRATING
}

model PixelOfficeLayout {
  id          String   @id @default(cuid())
  orgId       String   @unique
  name        String
  width       Int      @default(50)
  height      Int      @default(30)
  floors      Int      @default(1)
  tiles       Json     @default("[]") // floor tile data
  walls       Json     @default("[]")
  furniture   Json     @default("[]") // desks, chairs, plants, etc.
  spawnPoints Json     @default("[]")
  metadata    Json     @default("{}")
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("pixel_office_layouts")
}

// ═══════════════════════════════════════════════════════════════
// JARVIS / MARK-X.1 (Voice Control)
// ═══════════════════════════════════════════════════════════════

model VoiceCommand {
  id            String   @id @default(cuid())
  orgId         String
  userId        String
  transcript    String
  intent        String
  entities      Json     @default("{}")
  confidence    Float
  action        String?
  actionParams  Json     @default("{}")
  result        Json?
  status        VoiceCommandStatus @default(PROCESSING)
  error         String?
  duration      Int      // ms
  createdAt     DateTime @default(now())

  @@index([orgId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("voice_commands")
}

enum VoiceCommandStatus {
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REQUIRES_CONFIRMATION
}

model JarvisSettings {
  id            String   @id @default(cuid())
  orgId         String   @unique
  wakeWord      String   @default("jarvis")
  language      String   @default("en-US")
  voiceId       String   @default("default")
  speakResponses Boolean @default(true)
  confirmActions Boolean @default(true)
  allowedUsers  String[] @default([])
  allowedCommands String[] @default([])
  metadata      Json     @default("{}")
  updatedAt     DateTime @updatedAt

  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("jarvis_settings")
}
