{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "lint": {},
    "typecheck": {},
    "db:generate": {},
    "db:push": {},
    "db:seed": {},
    "clean": {
      "cache": false
    }
  },
  "globalEnv": [
    "DATABASE_URL",
    "CLERK_SECRET_KEY",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_CLERK_SIGN_IN_URL",
    "NEXT_PUBLIC_CLERK_SIGN_UP_URL",
    "FACTORY_ENCRYPTION_KEY",
    "OPENAI_API_KEY",
    "ANTHROPIC_API_KEY",
    "OPENROUTER_API_KEY",
    "GROQ_API_KEY",
    "NVIDIA_API_KEY",
    "OLLAMA_BASE_URL",
    "OLLAMA_MODEL",
    "HERMES_BASE_URL",
    "TELEGRAM_BOT_TOKEN",
    "RAZORPAY_KEY_ID",
    "CLARITY_API_TOKEN",
    "GOOGLE_SEARCH_CONSOLE_ACCESS_TOKEN",
    "GOOGLE_SEARCH_CONSOLE_SITE_URL"
  ]
}
